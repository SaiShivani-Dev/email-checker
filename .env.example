# Copy to .env if you use a tool that loads it (the app itself reads real environment variables).
# SMTP_MODE=auto            auto | on | off   (auto probes outbound port 25 once and caches the answer)
# VERIFY_MAIL_FROM=check@yourdomain.com   envelope sender for MAIL FROM: use a domain you own
# HELO_HOSTNAME=checker.yourdomain.com    name announced in EHLO (default: this host's FQDN)
# MAX_EMAILS=10             addresses per request
# SMTP_DELAY=1              seconds between SMTP checks
# SMTP_TIMEOUT=8            seconds per SMTP operation
# RATE_LIMIT_PER_MINUTE=20  requests per minute per client IP
# PORT=5000                 used by python app.py
